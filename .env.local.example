# Copy this file to .env.local and fill in your Supabase project values.
# Found at: https://app.supabase.com/project/_/settings/api

# --- Public Supabase (used in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only (NEVER expose these to the browser) ---
# Service role key bypasses RLS so the /admin page can read every RSVP.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The secret slug that gates the admin page. Visit /admin/<this-value>.
# Pick something only you would know — e.g. "rings-2026" or a uuid.
ADMIN_TOKEN=your-secret-slug

# Maximum number of confirmed child spots. Defaults to 20 if unset.
NEXT_PUBLIC_KID_CAPACITY=20
